<plugin resizable="true">
	<grid rows="2" cols="2" spacing="4" transpose="true">
		<!-- Column 1 -->
		<group text="groups.stereo_adjust">
			<vbox>
				<hbox>
					<button id="lr_on" text="labels.active" />
					<button id="lr_ph" text="labels.chan.phase" />
					<label text="labels.measure" />
					<ledmeter hexpand="true" height.min="256" angle="0">
						<ledchannel id="lr_mll" min="-72 db" max="24 db" log="true" type="rms_peak" peak.visibility="true" value.color="left"/>
						<ledchannel id="lr_mlr" min="-72 db" max="24 db" log="true" type="rms_peak" peak.visibility="true" value.color="right"/>
					</ledmeter>
				</hbox>
				<grid rows="5" cols="10">
					<!--  rows 1: headings -->
					<cell cols="2">
						<label text="labels.signal.pregain" />
					</cell>
					<cell cols="2">
						<label text="labels.signal.pan" />
					</cell>
					<cell rows="2">
						<label text="labels.signal.pre-balance" />
					</cell>
					<cell rows="2">
						<label text="labels.signal.rotate" />
					</cell>
					<cell cols="2">
						<label text="labels.signal.postgain" />
					</cell>
					<cell rows="2">
						<label text="labels.signal.post-balance" />
					</cell>
					<cell rows="2">
						<label text="labels.delay" />
					</cell>
					
					<!--  rows 2: headings -->
					<hbox>
						<label text="labels.chan.left" />
						<button id="lr_bpl" font.name="lsp-icons" text="icons.actions.phase" />
					</hbox>
					<hbox>
						<label text="labels.chan.right" />
						<button id="lr_bpr" font.name="lsp-icons" text="icons.actions.phase" />
					</hbox>
					
					<label text="labels.chan.left" />
					<label text="labels.chan.right" />
					
					<hbox>
						<label text="labels.chan.left" />
						<button id="lr_apl" font.name="lsp-icons" text="icons.actions.phase" />
					</hbox>
					<hbox>
						<label text="labels.chan.right" />
						<button id="lr_apr" font.name="lsp-icons" text="icons.actions.phase" />
					</hbox>
					
					<!-- Row 3: knobs -->
					<knob id="lr_blg" scolor="left" />
					<knob id="lr_brg" scolor="right" />
					
					<knob id="lr_pl" scolor="left" />
					<knob id="lr_pr" scolor="right" />
					
					<knob id="lr_bbal" />
					<knob id="lr_rot" balance="0" zero="0" />
					
					<knob id="lr_alg" scolor="left" />
					<knob id="lr_arg" scolor="right" />
					
					<knob id="lr_abal" />
					<knob id="lr_dly" />
					
					<!-- Row 4: values -->
					<value id="lr_blg" />
					<value id="lr_brg" />
					
					<value id="lr_pl" />
					<value id="lr_pr" />
					
					<value id="lr_bbal" />
					<value id="lr_rot" />
					
					<value id="lr_alg" />
					<value id="lr_arg" />
					
					<value id="lr_abal" />
					<value id="lr_dly" />
					
					<!-- Row 5: measure buttons -->
					<cell cols="2">
						<button id="lr_msr" text="labels.measure" value="0" />
					</cell>
					<cell cols="2">
						<button id="lr_msr" text="labels.measure" value="1" />
					</cell>
					<button id="lr_msr" text="labels.measure" value="2" />
					<button id="lr_msr" text="labels.measure" value="3" />
					<cell cols="2">
						<button id="lr_msr" text="labels.measure" value="4" />
					</cell>
					<button id="lr_msr" text="labels.measure" value="5" />
					<button id="lr_msr" text="labels.measure" value="6" />
				</grid>
			</vbox>
		</group>
		
		<group text="groups.ms_adjust">
			<vbox>
				<hbox>
					<button id="ms_on" text="labels.active" />
					<button id="ms_ph" text="labels.chan.phase" />
					<label text="labels.measure" />
					<ledmeter hexpand="true" height.min="256" angle="0">
						<ledchannel id="lr_mll" min="-72 db" max="24 db" log="true" type="rms_peak" peak.visibility="true" value.color="mid"/>
						<ledchannel id="lr_mlr" min="-72 db" max="24 db" log="true" type="rms_peak" peak.visibility="true" value.color="side"/>
					</ledmeter>
				</hbox>
				<grid rows="5" cols="10">
					<!--  rows 1: headings -->
					<cell cols="2">
						<label text="labels.signal.pregain" />
					</cell>
					<cell cols="2">
						<label text="labels.signal.pan" />
					</cell>
					<cell rows="2">
						<label text="labels.signal.pre-balance" />
					</cell>
					<cell rows="2">
						<label text="labels.signal.rotate" />
					</cell>
					<cell cols="2">
						<label text="labels.signal.postgain" />
					</cell>
					<cell rows="2">
						<label text="labels.signal.post-balance" />
					</cell>
					<cell rows="2">
						<label text="labels.delay" />
					</cell>
					
					<!--  rows 2: headings -->
					<hbox>
						<label text="labels.chan.mid" />
						<button id="ms_bpm" font.name="lsp-icons" text="icons.actions.phase" />
					</hbox>
					<hbox>
						<label text="labels.chan.side" />
						<button id="ms_bps" font.name="lsp-icons" text="icons.actions.phase" />
					</hbox>
					
					<label text="labels.chan.mid" />
					<label text="labels.chan.side" />
					
					<hbox>
						<label text="labels.chan.mid" />
						<button id="ms_apm" font.name="lsp-icons" text="icons.actions.phase" />
					</hbox>
					<hbox>
						<label text="labels.chan.side" />
						<button id="ms_aps" font.name="lsp-icons" text="icons.actions.phase" />
					</hbox>
					
					<!-- Row 3: knobs -->
					<knob id="ms_bmg" scolor="mid" />
					<knob id="ms_bsg" scolor="side" />
					
					<knob id="ms_pm" scolor="mid" />
					<knob id="ms_ps" scolor="side" />
					
					<knob id="ms_bbal" />
					<knob id="ms_rot" balance="0" zero="0" />
					
					<knob id="ms_amg" scolor="mid" />
					<knob id="ms_asg" scolor="side" />
					
					<knob id="ms_abal" />
					<knob id="ms_dly" />
					
					<!-- Row 4: values -->
					<value id="ms_bmg" />
					<value id="ms_bsg" />
					
					<value id="ms_pm" />
					<value id="ms_ps" />
					
					<value id="ms_bbal" />
					<value id="ms_rot" />
					
					<value id="ms_amg" />
					<value id="ms_asg" />
					
					<value id="ms_abal" />
					<value id="ms_dly" />
					
					<!-- Row 5: measure buttons -->
					<cell cols="2">
						<button id="ms_msr" text="labels.measure" value="0" />
					</cell>
					<cell cols="2">
						<button id="ms_msr" text="labels.measure" value="1" />
					</cell>
					<button id="ms_msr" text="labels.measure" value="2" />
					<button id="ms_msr" text="labels.measure" value="3" />
					<cell cols="2">
						<button id="ms_msr" text="labels.measure" value="4" />
					</cell>
					<button id="ms_msr" text="labels.measure" value="5" />
					<button id="ms_msr" text="labels.measure" value="6" />
				</grid>
			</vbox>
		</group>

		<!-- Column 2 -->		
		<cell rows="2">
			<group text="groups.analysis">
				<vbox>
					<!-- Goniometer with it's settings -->
					<grid rows="2" cols="2">
						<graph width.min="256" height.min="256" expand="true" fill="true" border.size="1" border.color="bg_light">
							<!-- Origin -->
							<origin halign="0.0" valign="0.0" visible="false"/>
	
							<marker v="0" dy=":_a_width" dx="+:_a_height" color="graph_alt_1" smooth="true"/>
							<marker v="0" dy=":_a_width" dx="-:_a_height" color="graph_alt_1" smooth="true"/>
	
							<!-- Secondary color -->
							<marker v="1" ox="1" oy="0" color="graph_sec"/>
							<marker v="0.5" ox="1" oy="0" color="graph_sec"/>
							<marker v="-0.5" ox="1" oy="0" color="graph_sec"/>
							<marker v="-1" ox="1" oy="0" color="graph_sec"/>
							<marker v="1" ox="0" oy="1" color="graph_sec"/>
							<marker v="0.5" ox="0" oy="1" color="graph_sec"/>
							<marker v="-0.5" ox="0" oy="1" color="graph_sec"/>
							<marker v="-1" ox="0" oy="1" color="graph_sec"/>
	
							<!-- Streams -->
							<stream id="gon" si="0" xi="1" yi="2" width="2" color="reference_ref_1" smooth="true" strobe="true" strobes=":goniohs" dots.max=":goniond" visibility=":gon_in" />
							<stream id="gon" si="0" xi="3" yi="4" width="2" color="reference_mix_1" smooth="true" strobe="true" strobes=":goniohs" dots.max=":goniond" visibility=":gon_out"/>
	
							<!-- Axes -->
							<axis min="-1.125" max="1.125" color="graph_prim" angle="1.0" log="false"/>
							<axis min="-1.125" max="1.125" color="graph_prim" angle="0.5" log="false"/>
	
							<!-- Text -->
							<text x="1" y="1" text="labels.chan.left" halign="1" valign="-1" pgroup="0" priority="0"/>
							<text x="-1" y="1" text="labels.chan.right" halign="-1" valign="-1" pgroup="0" priority="0"/>
	
							<ui:with y="0" halign="1" valign="-1">
								<text x="-1.125" text="labels.chan.side" pgroup="0" priority="0"/>
								<text x="-1" text="1" pgroup="0" priority="10"/>
								<text x="-0.5" text="0.5"/>
								<text x="0.5" text="-0.5"/>
								<text x="1" text="-1" halign="-1"/>
							</ui:with>
	
							<ui:with x="0" halign="1" valign="-1">
								<text y="1.125" text="labels.chan.mid" valign="1" pgroup="0" priority="0"/>
								<text y="1" text="1" pgroup="0" priority="10"/>
								<text y="0.5" text="0.5"/>
								<text y="0" text="0"/>
								<text y="-0.5" text="-0.5"/>
								<text y="-1" text="-1"/>
							</ui:with>
						</graph>
						<vbox>
							<label
								font.name="lsp-icons" font.size="12" font.antialias="true"
								text="icons.main.zoom" color="text_icon"
								pad.b="4" pad.t="4" />
							<fader id="zoom" angle="1" vexpand="true" bg.inherit="true" flat="true" />
							<value id="zoom" width="40" />
						</vbox>

						<cell cols="2">
							<hbox>
								<button id="gon_in" text="labels.chan.in" color="reference_ref_1" />
								<button id="gon_out" text="labels.chan.out" color="reference_mix_1" />
								
								<void hexpand="true" />
								
								<vbox vreduce="true" pad.b="2" width="120">
									<hbox pad.h="2">
										<label text="labels.history"/>
										<void hexpand="true"/>
										<value id="goniohs" sline="true"/>
									</hbox>
									<fader id="goniohs" angle="0" hfill="true" pad="0"/>
								</vbox>
								<vbox vreduce="true" pad.b="2" width="120">
									<hbox pad.h="2">
										<label text="labels.oscilloscope.max_dots"/>
										<void hexpand="true"/>
										<value id="goniond" sline="true"/>
									</hbox>
									<fader id="goniond" angle="0" hfill="true"/>
								</vbox>
							</hbox>
						</cell>
					</grid>
				</vbox>
			</group>
		</cell>
	</grid>
</plugin>
